[resource]
code = "shader_type canvas_item;
render_mode blend_mix;

uniform float waveSize : hint_range(0, 1) = 0.10000000149012;
uniform float cutoff : hint_range(0, 1);
uniform float frequency : hint_range(0, 0.20000000298023) = 0.03999999910593;
uniform float speed : hint_range(0, 30) = 20;
uniform float xOffset : hint_range(0, 1) = 0.10000000149012;



void fragment() {
// Input:3
	vec2 n_out3p0 = SCREEN_UV;
	float n_out3p1 = n_out3p0.r;
	float n_out3p2 = n_out3p0.g;


// FloatOp:6
	float n_in6p0 = 1.00000;
	float n_out6p0 = n_in6p0 - n_out3p2;


// FloatParameter:7
	float n_out7p0 = waveSize;


// FloatOp:35
	float n_in35p0 = 1.00000;
	float n_out35p0 = n_in35p0 - n_out7p0;


// FloatOp:36
	float n_out36p0 = n_out6p0 * n_out35p0;


// FloatParameter:2
	float n_out2p0 = cutoff;


// FloatParameter:13
	float n_out13p0 = frequency;


// FloatOp:15
	float n_out15p0 = n_out3p1 / n_out13p0;


// FloatParameter:14
	float n_out14p0 = speed;


// Input:16
	float n_out16p0 = TIME;


// FloatParameter:39
	float n_out39p0 = xOffset;


// MultiplyAdd:38
	vec2 n_out38p0 = (vec2(n_out14p0) * vec2(n_out16p0)) + vec2(n_out39p0);


// FloatOp:18
	float n_out18p0 = n_out15p0 + n_out38p0.x;


// FloatFunc:8
	float n_out8p0 = sin(n_out18p0);


// FloatFunc:9
	float n_out9p0 = abs(n_out8p0);


// FloatOp:10
	float n_out10p0 = n_out7p0 * n_out9p0;


// FloatOp:11
	float n_out11p0 = n_out2p0 - n_out10p0;


// Compare:33
	bool n_out33p0 = n_out36p0 < n_out11p0;


// Output:0
	COLOR.a = (n_out33p0 ? 1.0 : 0.0);


}
