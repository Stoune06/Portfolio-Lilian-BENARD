[resource]
code = "shader_type canvas_item;
render_mode blend_mix;

uniform float waveSize : hint_range(0, 1) = 0.10000000149012;
uniform float cutoff : hint_range(0, 1);
uniform float frequency : hint_range(0, 0.20000000298023) = 0.03999999910593;
uniform float speed : hint_range(0, 30) = 20;
uniform float xOffset : hint_range(0, 1) = 0.10000000149012;



void fragment() {
// Input:20
	vec2 n_out20p0 = UV;
	float n_out20p1 = n_out20p0.r;
	float n_out20p2 = n_out20p0.g;


	vec4 n_out22p0;
// Texture2D:22
	n_out22p0 = texture(TEXTURE, n_out20p0);
	float n_out22p4 = n_out22p0.a;


// FloatOp:2
	float n_in2p0 = 1.00000;
	float n_out2p0 = n_in2p0 - n_out20p2;


// FloatParameter:3
	float n_out3p0 = waveSize;


// FloatOp:11
	float n_in11p0 = 1.00000;
	float n_out11p0 = n_in11p0 - n_out3p0;


// FloatOp:12
	float n_out12p0 = n_out2p0 * n_out11p0;


// FloatParameter:13
	float n_out13p0 = cutoff;


// FloatParameter:19
	float n_out19p0 = frequency;


// FloatOp:8
	float n_out8p0 = n_out20p1 / n_out19p0;


// FloatParameter:15
	float n_out15p0 = speed;


// Input:16
	float n_out16p0 = TIME;


// FloatParameter:17
	float n_out17p0 = xOffset;


// MultiplyAdd:18
	vec2 n_out18p0 = (vec2(n_out15p0) * vec2(n_out16p0)) + vec2(n_out17p0);


// FloatOp:14
	float n_out14p0 = n_out8p0 + n_out18p0.x;


// FloatFunc:4
	float n_out4p0 = sin(n_out14p0);


// FloatFunc:5
	float n_out5p0 = abs(n_out4p0);


// FloatOp:6
	float n_out6p0 = n_out3p0 * n_out5p0;


// FloatOp:7
	float n_out7p0 = n_out13p0 - n_out6p0;


// Compare:10
	bool n_out10p0 = n_out12p0 < n_out7p0;


// FloatOp:23
	float n_out23p0 = n_out22p4 * (n_out10p0 ? 1.0 : 0.0);


// Output:0
	COLOR.a = n_out23p0;


}
