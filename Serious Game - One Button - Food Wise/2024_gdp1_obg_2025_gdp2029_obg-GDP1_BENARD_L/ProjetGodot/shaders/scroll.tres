code = "shader_type canvas_item;
render_mode blend_mix;

uniform vec2 Vector2Parameter = vec2(0.000000, 0.000000);



void fragment() {
// Input:2
	vec2 n_out2p0 = UV;


// Vector2Parameter:6
	vec2 n_out6p0 = Vector2Parameter;


// Input:7
	float n_out7p0 = TIME;


// VectorOp:8
	vec2 n_out8p0 = n_out6p0 * vec2(n_out7p0);


// VectorOp:3
	vec2 n_out3p0 = n_out2p0 + n_out8p0;


	vec2 n_out9p0;
// Expression:9
	n_out9p0 = vec2(0.0, 0.0);
	{
		n_out9p0 = mod(n_out3p0,vec2(1.0,1.0));
	}


	vec4 n_out5p0;
// Texture2D:5
	n_out5p0 = texture(TEXTURE, n_out9p0);


// Output:0
	COLOR.rgb = vec3(n_out5p0.xyz);


}
"
